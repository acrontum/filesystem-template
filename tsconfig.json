{
  /* https://github.com/tsconfig/bases/blob/main/bases/node20.json */
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "rootDir": ".",
    "sourceMap": true,
    "strictNullChecks": false,
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "test/fixtures"
  ]
}
